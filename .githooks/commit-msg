#!/bin/sh
# The repo's commit-msg hook. Farrier owns only the fenced region below; anything
# outside it is yours and survives `farrier install`.
set -eu
# >>> farrier: hooks (generated) >>>
root=$(git rev-parse --show-toplevel)
if [ -x "$root/.agents/hooks/commit-msg" ]; then "$root/.agents/hooks/commit-msg" "$1"; fi
# <<< farrier: hooks <<<
